generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  admin
  operations_manager
  support
  sales
  technician
}

enum LeadStatus {
  new
  qualified
  walkthrough_needed
  quoted
  won
  lost
  archived
}

enum WalkthroughStatus {
  scheduled
  in_progress
  completed
  canceled
}

enum EstimateStatus {
  draft
  sent
  approved
  rejected
  expired
}

enum WorkOrderStatus {
  new
  scheduled
  in_progress
  on_hold
  completed
  canceled
  closed
}

enum ScheduleEventStatus {
  scheduled
  confirmed
  in_progress
  completed
  canceled
}

enum ContractStatus {
  draft
  active
  paused
  expired
  canceled
}

enum InvoiceStatus {
  draft
  issued
  paid
  overdue
  void
}

enum ActivityEntityType {
  lead
  customer
  contact
  site
  walkthrough
  estimate
  work_order
  schedule_event
  contract
  asset
  invoice
  user
}

enum TaskStatus {
  todo
  in_progress
  blocked
  completed
  canceled
}

enum TaskPriority {
  low
  normal
  high
  urgent
}

enum AttachmentEntityType {
  walkthrough
  work_order
  asset
  site
  estimate
  invoice
}

enum TemplateType {
  checklist
  task
}

enum ChecklistStatus {
  draft
  in_progress
  completed
  canceled
}

enum NoteEntityType {
  work_order
  walkthrough
  schedule_event
  site
  asset
  estimate
  invoice
  checklist
  task
}

enum NoteType {
  general
  handoff
  issue
  resolution
  observation
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String?
  employeeCode String?      @unique
  firstName    String?
  lastName     String?
  phone        String?
  timezone     String?
  role         PlatformRole
  isActive     Boolean      @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assignedLeads          Lead[]          @relation("LeadAssignedTo")
  assignedWalkthroughs   Walkthrough[]   @relation("WalkthroughAssignedTo")
  assignedWorkOrders     WorkOrder[]     @relation("WorkOrderAssignedTo")
  scheduledEvents        ScheduleEvent[] @relation("ScheduleEventAssignedTo")
  activityLogs           ActivityLog[]   @relation("ActivityActor")
  assignedTasks          Task[]          @relation("TaskAssignedTo")
  assignedChecklistItems ChecklistItem[] @relation("ChecklistItemAssignedTo")
  uploadedAttachments    Attachment[]    @relation("AttachmentUploadedBy")
  createdNotes           Note[]          @relation("NoteCreatedBy")
}

model Lead {
  id                String     @id @default(cuid())
  leadNumber        String?    @unique
  externalReference String?
  companyName       String?
  contactName       String?
  email             String?
  phone             String?
  serviceType       String?
  source            String?
  notes             String?
  status            LeadStatus @default(new)
  qualifiedAt       DateTime?
  wonAt             DateTime?
  lostAt            DateTime?
  archivedAt        DateTime?
  lostReason        String?
  nextActionAt      DateTime?
  assignedToId      String?
  customerId        String?
  convertedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  assignedTo   User?         @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  walkthroughs Walkthrough[]
  estimates    Estimate[]
  activityLogs ActivityLog[]

  @@index([status, createdAt])
  @@index([assignedToId])
}

model Customer {
  id                String    @id @default(cuid())
  name              String
  customerNumber    String?   @unique
  externalReference String?
  legalName         String?
  billingEmail      String?
  billingPhone      String?
  billingAddress    String?
  notes             String?
  isActive          Boolean   @default(true)
  onboardedAt       DateTime?
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  leads        Lead[]
  contacts     Contact[]
  sites        Site[]
  walkthroughs Walkthrough[]
  estimates    Estimate[]
  workOrders   WorkOrder[]
  contracts    Contract[]
  invoices     Invoice[]
  activityLogs ActivityLog[]

  @@index([isActive, createdAt])
}

model Contact {
  id                     String    @id @default(cuid())
  customerId             String
  siteId                 String?
  externalReference      String?
  firstName              String
  lastName               String?
  email                  String?
  phone                  String?
  preferredContactMethod String?
  title                  String?
  isPrimary              Boolean   @default(false)
  notes                  String?
  archivedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  site         Site?         @relation(fields: [siteId], references: [id])
  activityLogs ActivityLog[]

  @@index([customerId, isPrimary])
}

model Site {
  id           String    @id @default(cuid())
  customerId   String
  siteCode     String?
  name         String
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  timezone     String?
  latitude     Float?
  longitude    Float?
  accessNotes  String?
  safetyNotes  String?
  serviceNotes String?
  isActive     Boolean   @default(true)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  walkthroughs Walkthrough[]
  workOrders   WorkOrder[]
  assets       Asset[]
  activityLogs ActivityLog[]

  @@index([customerId, isActive])
}

model Walkthrough {
  id              String            @id @default(cuid())
  leadId          String?
  customerId      String?
  siteId          String?
  assignedToId    String?
  title           String?
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  notes           String?
  findings        String?
  recommendations String?
  status          WalkthroughStatus @default(scheduled)
  completedAt     DateTime?
  canceledAt      DateTime?
  cancelReason    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  lead         Lead?         @relation(fields: [leadId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  site         Site?         @relation(fields: [siteId], references: [id])
  assignedTo   User?         @relation("WalkthroughAssignedTo", fields: [assignedToId], references: [id])
  estimates    Estimate[]
  activityLogs ActivityLog[]
  checklists   Checklist[]

  @@index([status, scheduledStart])
  @@index([leadId])
}

model Estimate {
  id                     String         @id @default(cuid())
  leadId                 String?
  customerId             String?
  walkthroughId          String?
  estimateNumber         String?        @unique
  externalReference      String?
  revisionNumber         Int            @default(1)
  title                  String?
  description            String?
  subtotal               Decimal?       @db.Decimal(10, 2)
  tax                    Decimal?       @db.Decimal(10, 2)
  total                  Decimal?       @db.Decimal(10, 2)
  status                 EstimateStatus @default(draft)
  sentAt                 DateTime?
  approvedAt             DateTime?
  rejectedAt             DateTime?
  expiresAt              DateTime?
  convertedToWorkOrderAt DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  lead         Lead?         @relation(fields: [leadId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
  walkthrough  Walkthrough?  @relation(fields: [walkthroughId], references: [id])
  workOrders   WorkOrder[]
  activityLogs ActivityLog[]

  @@index([status, createdAt])
  @@index([customerId])
}

model WorkOrder {
  id                 String          @id @default(cuid())
  customerId         String
  siteId             String
  estimateId         String?
  assignedToId       String?
  workOrderNumber    String?         @unique
  externalReference  String?
  title              String
  description        String?
  serviceType        String?
  priority           String?
  notes              String?
  internalNotes      String?
  status             WorkOrderStatus @default(new)
  dueAt              DateTime?
  scheduledStart     DateTime?
  scheduledEnd       DateTime?
  completedAt        DateTime?
  closedAt           DateTime?
  canceledAt         DateTime?
  cancellationReason String?
  resolutionSummary  String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  site           Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  estimate       Estimate?       @relation(fields: [estimateId], references: [id])
  assignedTo     User?           @relation("WorkOrderAssignedTo", fields: [assignedToId], references: [id])
  scheduleEvents ScheduleEvent[]
  invoices       Invoice[]
  activityLogs   ActivityLog[]
  tasks          Task[]
  checklists     Checklist[]

  @@index([status, scheduledStart])
  @@index([customerId, siteId])
}

model ScheduleEvent {
  id                 String              @id @default(cuid())
  workOrderId        String?
  assignedToId       String?
  title              String
  startsAt           DateTime
  endsAt             DateTime
  notes              String?
  status             ScheduleEventStatus @default(scheduled)
  confirmedAt        DateTime?
  completedAt        DateTime?
  canceledAt         DateTime?
  cancellationReason String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  workOrder    WorkOrder?    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  assignedTo   User?         @relation("ScheduleEventAssignedTo", fields: [assignedToId], references: [id])
  activityLogs ActivityLog[]

  @@index([assignedToId, startsAt])
  @@index([status, startsAt])
}

model Contract {
  id               String         @id @default(cuid())
  customerId       String
  name             String
  description      String?
  serviceFrequency String?
  billingFrequency String?
  startDate        DateTime?
  endDate          DateTime?
  renewalDate      DateTime?
  notes            String?
  status           ContractStatus @default(draft)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  activityLogs ActivityLog[]
}

model Asset {
  id               String    @id @default(cuid())
  siteId           String
  assetTag         String?   @unique
  name             String
  assetType        String?
  serialNumber     String?
  manufacturer     String?
  model            String?
  installedAt      DateTime?
  decommissionedAt DateTime?
  archivedAt       DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  activityLogs ActivityLog[]
  tasks        Task[]

  @@index([siteId, createdAt])
}

model Invoice {
  id                String        @id @default(cuid())
  customerId        String
  workOrderId       String?
  invoiceNumber     String?       @unique
  externalReference String?
  subtotal          Decimal?      @db.Decimal(10, 2)
  tax               Decimal?      @db.Decimal(10, 2)
  total             Decimal?      @db.Decimal(10, 2)
  dueDate           DateTime?
  issuedAt          DateTime?
  paidAt            DateTime?
  voidedAt          DateTime?
  voidReason        String?
  notes             String?
  status            InvoiceStatus @default(draft)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder?    @relation(fields: [workOrderId], references: [id])
  activityLogs ActivityLog[]

  @@index([status, dueDate])
  @@index([customerId, issuedAt])
}

model Task {
  id           String       @id @default(cuid())
  workOrderId  String
  assignedToId String?
  assetId      String?
  templateId   String?
  title        String
  description  String?
  status       TaskStatus   @default(todo)
  priority     TaskPriority @default(normal)
  taskType     String
  sortOrder    Int          @default(0)
  isRequired   Boolean      @default(true)
  dueAt        DateTime?
  completedAt  DateTime?
  resultNotes  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  workOrder  WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  assignedTo User?     @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  asset      Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([workOrderId, sortOrder])
  @@index([assignedToId, status])
  @@index([status, dueAt])
}

model Attachment {
  id            String               @id @default(cuid())
  entityType    AttachmentEntityType
  entityId      String
  fileName      String
  fileUrl       String
  fileType      String
  mimeType      String
  fileSizeBytes Int
  uploadedById  String?
  caption       String?
  category      String?
  sortOrder     Int?
  isPrimary     Boolean              @default(false)
  createdAt     DateTime             @default(now())

  uploadedBy User? @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([uploadedById, createdAt])
  @@index([entityType, category])
}

model Template {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  templateType TemplateType
  description  String?
  isActive     Boolean      @default(true)
  version      Int          @default(1)
  configJson   Json
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tasks      Task[]
  checklists Checklist[]

  @@index([templateType, isActive])
}

model Checklist {
  id            String          @id @default(cuid())
  title         String
  description   String?
  status        ChecklistStatus @default(draft)
  workOrderId   String?
  walkthroughId String?
  templateId    String?
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  workOrder   WorkOrder?      @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  walkthrough Walkthrough?    @relation(fields: [walkthroughId], references: [id], onDelete: SetNull)
  template    Template?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  items       ChecklistItem[]

  @@index([workOrderId, status])
  @@index([walkthroughId, status])
  @@index([templateId])
}

model ChecklistItem {
  id           String    @id @default(cuid())
  checklistId  String
  assignedToId String?
  title        String
  description  String?
  isCompleted  Boolean   @default(false)
  sortOrder    Int       @default(0)
  isRequired   Boolean   @default(true)
  completedAt  DateTime?
  resultNotes  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  checklist  Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  assignedTo User?     @relation("ChecklistItemAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([checklistId, sortOrder])
  @@index([assignedToId, isCompleted])
}

model Note {
  id          String         @id @default(cuid())
  entityType  NoteEntityType
  entityId    String
  createdById String
  noteType    NoteType
  content     String
  isInternal  Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdBy User @relation("NoteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([entityType, entityId, createdAt])
  @@index([createdById, createdAt])
}

model ActivityLog {
  id            String             @id @default(cuid())
  actorUserId   String?
  entityType    ActivityEntityType
  entityId      String
  action        String
  message       String?
  source        String?
  correlationId String?
  occurredAt    DateTime           @default(now())
  metadataJson  Json?
  createdAt     DateTime           @default(now())

  actor User? @relation("ActivityActor", fields: [actorUserId], references: [id])

  leadId          String?
  customerId      String?
  contactId       String?
  siteId          String?
  walkthroughId   String?
  estimateId      String?
  workOrderId     String?
  scheduleEventId String?
  contractId      String?
  assetId         String?
  invoiceId       String?

  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  site          Site?          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  walkthrough   Walkthrough?   @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  estimate      Estimate?      @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  workOrder     WorkOrder?     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  scheduleEvent ScheduleEvent? @relation(fields: [scheduleEventId], references: [id], onDelete: Cascade)
  contract      Contract?      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  asset         Asset?         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, action, createdAt])
}
